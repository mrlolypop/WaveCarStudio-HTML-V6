# Response headers for hosts that read _headers (Cloudflare Pages, Netlify).
# Parsed by the platform, never served as an asset.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Keep the internal build archive out of search results even if it is crawled.
/_archive/*
  X-Robots-Tag: noindex, nofollow

# Long-lived static assets.
/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=604800

/video/*
  Cache-Control: public, max-age=604800
