{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wavecarstudio-html-v5",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
